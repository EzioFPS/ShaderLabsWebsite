    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "imapflow": "^2.3.0",
    "mailparser": "^3.9.37",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
