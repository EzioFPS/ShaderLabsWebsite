# Copy this file to .env and fill in the values.

# Postgres connection string (Neon: Dashboard > Connect, pooling off, starts with postgresql://)
DATABASE_URL=""

# Contact form email delivery via Resend (https://resend.com). Leave empty to only save enquiries.
RESEND_API_KEY=""
MAIL_FROM="Shader Labs Website <website@shaderlabs.in>"
CONTACT_TO="mail@shaderlabs.in"

# Admin inbox at /admin
ADMIN_PASSWORD="change-me"
# Long random string used to sign the admin session cookie
ADMIN_SECRET="change-me-to-a-long-random-string"

# Public site URL (used for SEO metadata)
SITE_URL="https://shaderlabs.in"
