// Shader Labs website database: Postgres (hosted on Neon's free tier in production).
// Tables are created/updated by `prisma db push` during the Netlify build (netlify.toml)
// and before `npm run dev` / `npm start` locally (package.json).

generator client {
  provider      = "prisma-client-js"
  // "native" for local/build machines; rhel-openssl-3.0.x for Netlify Functions (AWS Lambda).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Enquiry {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  email       String
  company     String?
  website     String?
  phone       String?
  services    String   @default("[]") // JSON array of service labels
  budget      String?
  message     String

  // new | contacted | won | closed | spam
  status      String   @default("new")
  // pending | sent | failed | skipped
  emailStatus String   @default("pending")
  emailError  String?

  ip          String?
  userAgent   String?

  @@index([createdAt])
  @@index([status])
}

// ---------- Mailbox for mail@shaderlabs.in (/admin/mail) ----------
// Incoming mail arrives through Resend's receiving API, outgoing goes out through Resend,
// and the old Titan mailbox was imported once with scripts/import-titan.mjs.

model MailMessage {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  date           DateTime // when it was sent/received
  folder         String   @default("inbox") // inbox | sent | archive | spam | trash | drafts
  direction      String   // in | out
  source         String   // resend | compose | titan
  externalId     String?  @unique // Resend email id, or titan:<folder>:<uidvalidity>:<uid>

  rfcMessageId   String?  // Message-ID header, e.g. <abc@host>
  inReplyTo      String?
  references     String?  // space-separated Message-IDs
  threadKey      String   // groups a conversation

  fromAddress    String
  fromName       String?
  to             Json     @default("[]") // [{ name, address }]
  cc             Json     @default("[]")
  bcc            Json     @default("[]")
  replyTo        Json     @default("[]")
  subject        String   @default("")
  text           String?
  html           String?
  snippet        String   @default("")

  read           Boolean  @default(false)
  starred        Boolean  @default(false)
  hasAttachments Boolean  @default(false)
  complete       Boolean  @default(true) // false while attachments are still being fetched

  attachments    MailAttachment[]

  @@index([folder, date])
  @@index([threadKey])
  @@index([rfcMessageId])
  @@index([createdAt])
  @@index([date])
  @@index([read, direction, folder])
  @@index([starred, date])
}

// Resend ids of mail deleted for good, so a later sync doesn't bring it back.
model MailTombstone {
  externalId String   @id
  createdAt  DateTime @default(now())
}

// ---------- Billing (/admin/billing), backed by Xflow ----------
// Xflow keeps the money side (clients = "partners", invoices = "receivables", payments, payouts).
// These tables keep what Xflow doesn't: the invoice's line items and the business details printed on it.

model Invoice {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  number            String    @unique
  clientAccountId   String    // Xflow partner account id
  clientName        String
  clientEmail       String?
  clientAddress     String?
  clientTaxId       String?

  issueDate         DateTime
  dueDate           DateTime
  currency          String    @default("USD")
  items             Json      // [{ description, quantity, unitCents }]
  totalCents        Int
  notes             String?
  purposeCode       String

  status            String    @default("draft") // draft | registered | cancelled (payment state comes from Xflow)
  source            String    @default("dashboard") // dashboard | xflow (imported: its PDF is the one uploaded to Xflow)
  xflowFileId       String?
  xflowReceivableId String?   @unique
  paymentLinkId     String?
  paymentLinkUrl    String?
  sentAt            DateTime?
  sentTo            String?

  @@index([createdAt])
}

model BillingSettings {
  id                 Int     @id @default(1)
  legalName          String  @default("Shader Labs Private Limited")
  address            String  @default("Plot No 6011, M. Durga Nagar, Ayodhya Nagar, Nagpur 440024, Maharashtra, India")
  email              String  @default("mail@shaderlabs.in")
  cin                String  @default("U85499PN2023PTC220410")
  gstin              String?
  pan                String?
  lutNumber          String? // export of services under LUT, printed on invoices when set
  invoicePrefix      String  @default("SL")
  nextNumber         Int     @default(1)
  numberYear         String? // financial year the counter belongs to, e.g. 2026-27 (restarts at 1 each April)
  paymentTermsDays   Int     @default(15)
  defaultPurposeCode String  @default("P0802")
  footerNote         String? @default("Thank you for working with Shader Labs.")

  // USD receiving account printed under "How to pay" (from the Xflow dashboard → Receiving Accounts).
  bankName           String?
  bankAddress        String?
  bankAccountNumber  String?
  bankAccountType    String? @default("Business")
  bankSwift          String?
  bankAchRouting     String?
}

// Phones/browsers that asked for new-mail notifications (Web Push).
model PushSubscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
}

model MailAttachment {
  id          String      @id @default(cuid())
  mail        MailMessage @relation(fields: [mailId], references: [id], onDelete: Cascade)
  mailId      String
  filename    String
  contentType String
  size        Int
  contentId   String?     // for cid: images in the HTML body
  inline      Boolean     @default(false)
  externalId  String?     // Resend attachment id, so a retried download is never stored twice
  data        Bytes

  @@index([mailId])
}
